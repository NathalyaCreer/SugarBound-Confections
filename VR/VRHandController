using UnityEngine;
using UnityEngine.InputSystem;

public class VRHandController : MonoBehaviour
{
    public InventoryManager inventory;
    public InputActionReference throwAction;

    void OnEnable()
    {
        throwAction.action.performed += OnThrowPerformed;
    }

    void OnDisable()
    {
        throwAction.action.performed -= OnThrowPerformed;
    }

}